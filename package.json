{
  "private": true,
  "name": "excalidraw-monorepo",
  "packageManager": "pnpm@10.32.1",
  "devDependencies": {
    "@babel/preset-env": "7.26.9",
    "@excalidraw/eslint-config": "1.0.3",
    "@excalidraw/prettier-config": "1.0.2",
    "@testing-library/jest-dom": "6.6.3",
    "@types/chai": "4.3.0",
    "@types/jest": "27.4.0",
    "@types/lodash.throttle": "4.1.7",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "@vitejs/plugin-react": "3.1.0",
    "@vitest/coverage-v8": "3.0.7",
    "@vitest/ui": "2.0.5",
    "chai": "4.3.6",
    "dotenv": "16.0.1",
    "eslint-config-prettier": "8.5.0",
    "eslint-config-react-app": "7.0.1",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-prettier": "3.3.1",
    "http-server": "14.1.1",
    "husky": "7.0.4",
    "jsdom": "22.1.0",
    "lint-staged": "12.3.7",
    "pepjs": "0.5.3",
    "prettier": "2.6.2",
    "rewire": "6.0.0",
    "rimraf": "^5.0.0",
    "typescript": "5.9.3",
    "vite": "5.4.21",
    "vite-plugin-checker": "0.7.2",
    "vite-plugin-svgr": "4.2.0",
    "vitest": "3.0.6",
    "vitest-canvas-mock": "0.3.3"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "homepage": ".",
  "prettier": "@excalidraw/prettier-config",
  "scripts": {
    "build:app:docker": "pnpm --dir ./excalidraw-app run build:app:docker",
    "build": "pnpm --dir ./excalidraw-app run build",
    "dev": "pnpm --dir ./excalidraw-app run dev",
    "start": "pnpm dev",
    "start:production": "pnpm build && node ./excalidraw-app/workspace/server.ts",
    "test:all": "pnpm test:typecheck && pnpm test:code && pnpm test:other && pnpm test:app --watch=false",
    "test:app": "vitest",
    "test:code": "pnpm test:no-mjs && eslint --max-warnings=0 --ext .js,.ts,.tsx .",
    "test:no-mjs": "node ./scripts/check-no-mjs-outside-scripts.mjs",
    "test:other": "pnpm prettier --list-different",
    "test:typecheck": "tsc",
    "test:update": "pnpm test:app --update --watch=false",
    "test": "pnpm test:app",
    "test:coverage": "vitest --coverage",
    "test:coverage:watch": "vitest --coverage --watch",
    "test:workspace": "node --test ./excalidraw-app/workspace/server.node-test.ts",
    "test:ai": "node --test ./excalidraw-app/ai/server/*.node-test.ts",
    "test:ui": "pnpm test --ui --coverage.enabled=true",
    "fix:code": "pnpm test:code --fix",
    "fix:other": "pnpm prettier --write",
    "fix": "pnpm fix:other && pnpm fix:code",
    "prepare": "husky install",
    "prettier": "prettier \"**/*.{css,scss,json,md,html,yml}\" --ignore-path=.eslintignore",
    "rm:build": "rimraf --glob excalidraw-app/build excalidraw-app/dist excalidraw-app/dev-dist packages/*/dist packages/*/build",
    "rm:node_modules": "rimraf --glob node_modules excalidraw-app/node_modules packages/*/node_modules",
    "clean-install": "pnpm rm:node_modules && pnpm install --frozen-lockfile"
  },
  "pnpm": {
    "overrides": {
      "strip-ansi": "6.0.1"
    }
  },
  "dependencies": {
    "motion": "^13.1.0"
  }
}
